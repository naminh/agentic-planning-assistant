# Copy to `.env` and fill in. Never commit `.env`.

# OpenRouter (OpenAI-compatible API). Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: IANA timezone used by `uv run openrouter-status` to show key expiry
# OPENROUTER_STATUS_TIMEZONE=Europe/London

# Optional: LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=

# Optional: model overrides (defaults live in src/config.py)
# MODEL_CHEAP=
# MODEL_STRONG=
# MODEL_JUDGE=
# MODEL_VERIFIER2=

# Optional: Jev decision model (on by default; see README)
# JEV_DECIDE=on          # off | shadow | on
# JEV_STAGES=            # comma list, "none" disables
